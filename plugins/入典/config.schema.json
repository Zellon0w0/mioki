{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "入典 插件配置",
  "description": "生成入典图片的插件配置参数",
  "type": "object",
  "properties": {
    "enabled": {
      "title": "启用状态",
      "type": "boolean",
      "default": true,
      "description": "是否开启本插件"
    },
    "whitelist": {
      "title": "白名单群号",
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "允许使用本插件的 QQ 群号，留空代表不限制，每行一个"
    }
  },
  "required": [
    "enabled",
    "whitelist"
  ]
}

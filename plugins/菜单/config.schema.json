{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "菜单 插件配置",
  "description": "自定义指令菜单展示，使用简洁美观的 Material 3 风格高清图片渲染",
  "type": "object",
  "properties": {
    "enabled": {
      "title": "启用状态",
      "type": "boolean",
      "default": true,
      "description": "是否启用菜单指令功能"
    },
    "command": {
      "title": "触发指令",
      "type": "string",
      "default": "菜单",
      "description": "发送该文字将触发菜单，如：菜单。注：同时支持全局前缀"
    },
    "title": {
      "title": "菜单大标题",
      "type": "string",
      "default": "MIOKI ASSISTANT",
      "description": "展示在菜单最顶端的机器人主标题"
    },
    "subtitle": {
      "title": "菜单副标题",
      "type": "string",
      "default": "清晰有序的指令菜单",
      "description": "大标题下方的补充说明或版本描述"
    },
    "theme": {
      "title": "菜单视觉主题",
      "type": "string",
      "default": "material-light",
      "description": "菜单的配色主题样式",
      "enum": ["material-light", "material-warm", "material-dark"],
      "enumNames": ["Material 3 清爽浅色", "Material 3 暖色调", "Material 3 深色"]
    },
    "whitelist": {
      "title": "白名单群组",
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "仅在此白名单群聊中响应菜单指令，为空代表全局响应，每行一个"
    },
    "categories": {
      "title": "功能菜单分组",
      "type": "array",
      "items": {
        "title": "菜单卡片",
        "type": "object",
        "properties": {
          "name": {
            "title": "分组名称 (例如: 60s 资讯)",
            "type": "string"
          },
          "badge": {
            "title": "分组标签 (例如: 60s)",
            "type": "string"
          },
          "desc": {
            "title": "功能描述",
            "type": "string"
          },
          "commands": {
            "title": "指令命令列表",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "该分组包含的指令列表，每行一个"
          },
          "order": {
            "title": "排序序号",
            "type": "integer",
            "default": 10,
            "description": "自定义菜单卡片排序，数字越小越靠前"
          },
          "width": {
            "title": "卡片宽度",
            "type": "integer",
            "default": 1,
            "enum": [1, 2],
            "enumNames": ["半宽 (单栏)", "全宽 (双栏)"],
            "description": "自定义该菜单卡片的尺寸。在 PC 布局下，半宽占一栏，全宽占两栏。"
          }
        },
        "required": ["name"]
      },
      "description": "点击下方按钮增删或拖拽更改菜单展示分组及其包含的命令"
    }
  }
}
